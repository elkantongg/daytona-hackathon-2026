# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Neo4j AuraDB (credentials file from Aura). On Aura Free the database name is the instance id.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=
NEO4J_DATABASE=<instance-id>

# Daytona (app.daytona.io → Keys). Required: recovery and verification run in a Daytona sandbox.
DAYTONA_API_KEY=
# Optional overrides
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# Offline development only: run the engine as a local subprocess instead of Daytona.
# The dashboard shows a warning banner whenever this is on. Keep it off for the demo.
# ALLOW_LOCAL_EXECUTION=true

# Nosana: an Ollama LLM (Qwen 3.5 9B) on a Nosana GPU interprets free-text incidents and words
# explanations. It never decides feasibility. Easiest setup:
#   1. Create a key at deploy.nosana.com/developers (Credits: read, Deployments: read+write)
#   2. cd backend && uv run python scripts/nosana.py up      (fills in the three values below)
#   3. When you're done: uv run python scripts/nosana.py down
NOSANA_API_KEY=
NOSANA_LLM_URL=
NOSANA_LLM_MODEL=
NOSANA_DEPLOYMENT_ID=
# Only if your endpoint needs its own bearer token (the platform key is never sent to the node)
# NOSANA_LLM_KEY=
